{
    "name": "hampel/dev-null-zero",
    "description": "Commit to /dev/null (dev-null.sh) from the command line, signed with an SSH key on your GitHub account.",
    "keywords": [
        "dev-null",
        "ssh",
        "console",
        "cli"
    ],
    "homepage": "https://github.com/hampel/dev-null-zero",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/hampel/dev-null-zero/issues",
        "source": "https://github.com/hampel/dev-null-zero"
    },
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com"
        }
    ],
    "require": {
        "php": "^8.3.0",
        "illuminate/http": "^13.0",
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.30.4",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.7.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": [
        "devnull"
    ],
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "check": [
            "@analyse",
            "@test"
        ],
        "build": [
            "@composer install --no-dev --no-interaction",
            "@php devnull app:build devnull",
            "@composer install --no-interaction",
            "if grep -aq 'laravel/pint' builds/devnull; then echo 'ERROR: the build contains dev dependencies - do not release it'; exit 1; fi"
        ]
    },
    "scripts-descriptions": {
        "build": "Compile the phar without dev dependencies, then restore them",
        "analyse": "Static analysis at the level phpstan.neon records",
        "check": "Everything a change should pass before it is committed"
    }
}
